// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum OrderStatus {
  abierta
  en_progreso
  pendiente_piezas
  cerrada
}

model Settings {
  id           String   @id @default("singleton")
  workshopName String   @default("Automecanica Sera")
  taxId        String   @default("")
  address      String   @default("")
  phone        String   @default("")
  email        String   @default("")
  logoUrl      String   @default("")
  hourlyRate   Decimal  @default(0) @db.Decimal(10, 2)
  checklist    String[] @default(["Neumaticos", "Pastillas de freno", "Discos de freno", "Amortiguadores", "Niveles de liquidos", "Bateria", "Luces", "Escobillas", "Correa de distribucion", "Filtro de aire", "Aceite motor", "Suspension y direccion"])
  aiApiKey     String   @default("")
  nextInvoiceNumberOverride String @default("")
  passwordHash String
  passwordSalt String
}

model Customer {
  id        String    @id @default(cuid())
  name      String
  phone     String    @default("")
  email     String    @default("")
  address   String    @default("")
  taxId     String    @default("")
  createdAt DateTime  @default(now())
  vehicles  Vehicle[]
}

model Vehicle {
  id              String         @id @default(cuid())
  plate           String         @unique
  brand           String         @default("")
  model           String         @default("")
  vin             String         @default("")
  mileage         Int?
  customer        Customer       @relation(fields: [customerId], references: [id])
  customerId      String
  pendingPayments Decimal        @default(0) @db.Decimal(10, 2)
  createdAt       DateTime       @default(now())
  history         HistoryEntry[]
  warranties      Warranty[]
}

model HistoryEntry {
  id        String   @id @default(cuid())
  vehicle   Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  vehicleId String
  text      String
  date      DateTime @default(now())
}

model Warranty {
  id        String   @id @default(cuid())
  vehicle   Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  vehicleId String
  text      String
  addedAt   DateTime @default(now())
}

model Order {
  id          String      @id @default(cuid())
  plate       String
  description String      @default("")
  status      OrderStatus @default(abierta)
  createdAt   DateTime    @default(now())
  items       OrderItem[]
  timeEntries TimeEntry[]
  reception   Reception?
}

enum BudgetStatus {
  sin_enviar
  enviado
  aceptado
  rechazado
}

model Reception {
  id              String          @id @default(cuid())
  order           Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId         String          @unique
  createdAt       DateTime        @default(now())
  mileage         Int?
  checkpoints     Json            @default("{}")
  budgetStatus    BudgetStatus    @default(sin_enviar)
  sentAt          DateTime?
  requestedItems  RequestedItem[]
  findings        Finding[]
}

model RequestedItem {
  id          String    @id @default(cuid())
  reception   Reception @relation(fields: [receptionId], references: [id], onDelete: Cascade)
  receptionId String
  text        String
}

model Finding {
  id          String    @id @default(cuid())
  reception   Reception @relation(fields: [receptionId], references: [id], onDelete: Cascade)
  receptionId String
  text        String
  price       Decimal?  @db.Decimal(10, 2)
  photos      String[]  @default([])
}

model Article {
  id         String      @id @default(cuid())
  name       String
  price      Decimal     @db.Decimal(10, 2)
  costPrice  Decimal     @default(0) @db.Decimal(10, 2)
  orderItems OrderItem[]
}

model OrderItem {
  id        String   @id @default(cuid())
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId   String
  article   Article? @relation(fields: [articleId], references: [id], onDelete: SetNull)
  articleId String?
  name      String
  price     Decimal  @db.Decimal(10, 2)
  costPrice Decimal  @default(0) @db.Decimal(10, 2)
  qty       Int      @default(1)
}

enum PaymentStatus {
  pendiente
  cobrada
  parcial
}

enum PaymentMethod {
  efectivo
  tarjeta
  transferencia
  otro
}

model Invoice {
  id            String        @id @default(cuid())
  number        String        @unique
  plate         String
  clientName    String        @default("")
  clientNif     String        @default("")
  clientAddress String        @default("")
  subtotal      Decimal       @db.Decimal(10, 2)
  vatTotal      Decimal       @db.Decimal(10, 2)
  total         Decimal       @db.Decimal(10, 2)
  createdAt     DateTime      @default(now())
  prevHash      String        @default("")
  hash          String
  paymentStatus PaymentStatus @default(pendiente)
  paymentMethod PaymentMethod?
  paidAmount    Decimal       @default(0) @db.Decimal(10, 2)
  paidAt        DateTime?
  items         InvoiceItem[]
}

model InvoiceItem {
  id        String  @id @default(cuid())
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  invoiceId String
  concept   String
  qty       Int     @default(1)
  unitPrice Decimal @db.Decimal(10, 2)
  vat       Int     @default(21)
}

enum AppointmentStatus {
  pendiente
  confirmada
  cancelada
}

model Appointment {
  id         String            @id @default(cuid())
  date       DateTime
  plate      String            @default("")
  clientName String            @default("")
  reason     String            @default("")
  notes      String            @default("")
  status     AppointmentStatus @default(pendiente)
  createdAt  DateTime          @default(now())
  orderId    String?
}

model Diagnosis {
  id          String   @id @default(cuid())
  plate       String   @default("")
  symptoms    String
  aiResponse  String
  resolved    Boolean  @default(false)
  resolution  String   @default("")
  createdAt   DateTime @default(now())
}

model TimeEntry {
  id         String    @id @default(cuid())
  task       String
  plate      String    @default("")
  order      Order?    @relation(fields: [orderId], references: [id])
  orderId    String?
  start      DateTime  @default(now())
  end        DateTime?
  pausedMs   Int       @default(0)
  paused     Boolean   @default(false)
  pauseStart DateTime?
}
